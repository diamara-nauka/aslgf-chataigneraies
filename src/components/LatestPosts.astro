---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('fr-FR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
};
---

<section id="latest-posts" class="latest-posts-section">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-badge">Vie de la forêt</span>
      <h2>Dernières Actualités</h2>
      <p class="section-subtitle">
        Découvrez les dernières informations, chantiers et récits autour de la
        forêt des Châtaigneraies.
      </p>
    </div>

    <div class="posts-grid reveal-stagger">
      {
        sortedPosts.map(post => (
          <article class="post-card">
            <a href={`/posts/${post.id}/`} class="post-card-link">
              <div class="card-content">
                <div class="card-meta">
                  <span class="post-date">{formatDate(post.data.date)}</span>
                </div>
                <h3 class="post-title">{post.data.title}</h3>
                <p class="post-description">{post.data.description}</p>
                <div class="card-footer">
                  <span class="read-more">
                    Lire l'article
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <line x1="5" y1="12" x2="19" y2="12" />
                      <polyline points="12 5 19 12 12 19" />
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          </article>
        ))
      }
    </div>

    <div class="view-all-container reveal">
      <a href="/actualites" class="btn-primary-custom">
        Voir toutes les actualités
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .latest-posts-section {
    padding: 7rem 0;
    background-color: var(--bg-light);
  }

  .section-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 4rem auto;
  }

  .section-badge {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent);
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .section-header h2 {
    font-size: 2.8rem;
    color: var(--primary);
    margin-bottom: 1rem;
  }

  .section-subtitle {
    font-size: 1.15rem;
    color: #4a5568;
    line-height: 1.6;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  .post-card {
    background: var(--white);
    border-radius: 16px;
    border: 1px solid rgba(0, 0, 0, 0.05);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .post-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(26, 47, 35, 0.08);
    border-color: rgba(130, 172, 74, 0.3);
  }

  .post-card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2rem;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-meta {
    margin-bottom: 1rem;
  }

  .post-date {
    font-size: 0.85rem;
    color: var(--accent);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-title {
    font-size: 1.4rem;
    color: var(--primary);
    margin-bottom: 0.85rem;
    font-family: 'Playfair Display', serif;
    line-height: 1.35;
    transition: color 0.3s ease;
  }

  .post-card:hover .post-title {
    color: var(--accent);
  }

  .post-description {
    font-size: 0.98rem;
    color: #4a5568;
    line-height: 1.6;
    margin-bottom: 2rem;
    flex-grow: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    padding-top: 1rem;
    border-top: 1px solid #edf2f7;
  }

  .read-more {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--primary);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition:
      gap 0.3s ease,
      color 0.3s ease;
  }

  .post-card:hover .read-more {
    color: var(--accent);
    gap: 0.8rem;
  }

  .view-all-container {
    text-align: center;
  }

  .btn-primary-custom {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background-color: var(--primary);
    color: var(--white);
    padding: 1rem 2.2rem;
    border-radius: 50px;
    font-weight: 700;
    text-decoration: none;
    font-size: 1rem;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(26, 47, 35, 0.15);
  }

  .btn-primary-custom:hover {
    background-color: var(--accent);
    color: var(--primary);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(130, 172, 74, 0.3);
  }

  @media (max-width: 768px) {
    .latest-posts-section {
      padding: 4rem 0;
    }
    .section-header h2 {
      font-size: 2.2rem;
    }
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
