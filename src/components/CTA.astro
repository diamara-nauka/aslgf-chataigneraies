---
import { Image } from 'astro:assets';
import impactImage from '../assets/img/IMG_20260310_152934.jpg';
---

<section id="action" class="cta">
  <div class="cta-container">
    <Image
      src={impactImage}
      alt="Impact de la protection forestière"
      class="cta-bg"
      format="png"
      quality={80}
    />
    <div class="cta-overlay"></div>
    <div class="cta-content">
      <h2>L'impact de votre soutien est immense</h2>
      <p>
        Chaque don, chaque heure de bénévolat contribue à préserver un poumon
        vert pour notre terre.
      </p>
      <a href="#" class="btn btn-primary">Devenir Gardien</a>
    </div>
  </div>
</section>

<style>
  .cta {
    padding: 8rem 0;
  }

  .cta-container {
    position: relative;
    border-radius: 3rem;
    overflow: hidden;
    padding: 8rem 4rem;
    text-align: center;
    color: white;
    box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.3);
    max-width: 1200px;
    margin: 0 auto;
  }

  .cta-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .cta-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 42, 32, 0.7);
    z-index: -1;
  }

  .cta-content {
    max-width: 700px;
    margin: 0 auto;
    position: relative;
  }

  .cta-content h2 {
    font-size: 3.5rem;
    margin-bottom: 2rem;
    font-family: 'Playfair Display', serif;
  }

  .cta-content p {
    font-size: 1.25rem;
    margin-bottom: 3rem;
    opacity: 0.9;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .cta-container {
      padding: 6rem 2rem;
      border-radius: 0;
    }
  }
</style>
