---
// Drawer de navigation mobile uniquement
---

<div id="drawer" class="drawer">
  <div class="drawer-header">
    <span class="drawer-logo">Menu</span>
    <button id="drawer-close" aria-label="Fermer le menu">&times;</button>
  </div>
  <div class="drawer-content">
    <nav class="mobile-nav">
      <ul>
        <li><a href="/">Accueil</a></li>
        <li><a href="/#mission">Mission</a></li>
        <li><a href="/actualites">Actualités</a></li>
        <li><a href="/partenaires">Partenaires</a></li>
      </ul>
    </nav>
  </div>
</div>
<div id="drawer-overlay" class="drawer-overlay"></div>

<style>
  .drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 320px;
    height: 100vh;
    background: var(--primary);
    z-index: 2000;
    box-shadow: -10px 0 50px rgba(0, 0, 0, 0.3);
    transform: translateX(100%);
    transition: transform 0.45s cubic-bezier(0.77, 0, 0.175, 1);
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 400px) {
    .drawer {
      width: 100%;
    }
  }

  .drawer.open {
    transform: translateX(0);
  }

  .drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    z-index: 1999;
    opacity: 0;
    visibility: hidden;
    transition: all 0.45s ease;
  }

  .drawer-overlay.open {
    opacity: 1;
    visibility: visible;
  }

  .drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2.5rem 2.5rem 2rem 2.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .drawer-logo {
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--accent);
  }

  #drawer-close {
    background: none;
    border: none;
    font-size: 2rem;
    color: white;
    cursor: pointer;
    line-height: 1;
    padding: 0;
    transition:
      color 0.3s ease,
      transform 0.3s ease;
    opacity: 0.7;
  }

  #drawer-close:hover {
    color: var(--accent);
    opacity: 1;
    transform: rotate(90deg);
  }

  .drawer-content {
    padding: 3rem 2.5rem;
    flex: 1;
  }

  .mobile-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-nav li {
    opacity: 0;
    transform: translateX(20px);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .drawer.open .mobile-nav li {
    opacity: 1;
    transform: translateX(0);
  }

  .drawer.open .mobile-nav li:nth-child(1) {
    transition-delay: 0.1s;
  }
  .drawer.open .mobile-nav li:nth-child(2) {
    transition-delay: 0.15s;
  }
  .drawer.open .mobile-nav li:nth-child(3) {
    transition-delay: 0.2s;
  }
  .drawer.open .mobile-nav li:nth-child(4) {
    transition-delay: 0.25s;
  }

  .mobile-nav a {
    font-size: 1.8rem;
    font-weight: 800;
    color: white;
    text-decoration: none;
    font-family: 'Playfair Display', serif;
    display: block;
    padding: 0.5rem 0;
    transition: color 0.3s ease;
    border-bottom: 1px solid transparent;
  }

  .mobile-nav a:hover {
    color: var(--accent);
  }
</style>

<script>
  const drawer = document.getElementById('drawer');
  const overlay = document.getElementById('drawer-overlay');
  const toggle = document.getElementById('drawer-toggle');
  const close = document.getElementById('drawer-close');

  const openDrawer = () => {
    drawer?.classList.add('open');
    overlay?.classList.add('open');
    document.body.style.overflow = 'hidden';
    document.body.style.touchAction = 'none';
  };

  const closeDrawer = () => {
    drawer?.classList.remove('open');
    overlay?.classList.remove('open');
    document.body.style.overflow = '';
    document.body.style.touchAction = '';
  };

  toggle?.addEventListener('click', openDrawer);
  close?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);

  drawer?.addEventListener('click', e => {
    const target = e.target as HTMLElement | null;
    if (target?.closest('a')) {
      closeDrawer();
    }
  });
</script>
